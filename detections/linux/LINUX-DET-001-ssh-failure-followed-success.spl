index="soc-live" host="soc-ubuntu-01" source="/var/log/auth.log"
("Accepted password" OR "Accepted publickey" OR "Failed password" OR "Failed publickey")
| rex field=_raw "sshd\[(?<sshd_pid>\d+)\]"
| rex field=_raw "(?<auth_status>Accepted|Failed) (?<method>password|publickey) for (?:invalid user )?(?<account>\S+) from (?<src_ip>(?:\d{1,3}\.){3}\d{1,3}) port (?<src_port>\d+)"
| eval outcome=case(auth_status="Accepted","Success",auth_status="Failed","Failure")
| where isnotnull(outcome) AND isnotnull(src_ip) AND isnotnull(sshd_pid)
| stats
    count(eval(outcome="Failure")) as failures
    count(eval(outcome="Success")) as successes
    max(eval(if(outcome="Failure",_time,null()))) as last_failure
    min(eval(if(outcome="Success",_time,null()))) as first_success
    by host account src_ip src_port sshd_pid
| where failures>=3 AND successes>=1 AND last_failure<first_success
| eval seconds_from_failure_to_success=round(first_success-last_failure,2)
| eval first_success=strftime(first_success,"%Y-%m-%d %H:%M:%S")
| eval last_failure=strftime(last_failure,"%Y-%m-%d %H:%M:%S")
| table host account src_ip src_port sshd_pid failures successes last_failure first_success seconds_from_failure_to_success
| sort 0 -failures
