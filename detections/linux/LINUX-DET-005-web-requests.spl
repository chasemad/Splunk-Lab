index="soc-live" host="soc-ubuntu-01" source="/opt/soc-web-logs/access.log"
| rex field=_raw "^(?<client_ip>(?:\d{1,3}\.){3}\d{1,3})"
| rex field=_raw "\"(?<http_method>GET|POST|HEAD|PUT|DELETE|OPTIONS|PATCH)\s+(?<url_path>\S+)(?:\s+HTTP/[0-9.]+)?\"\s+(?<http_status>\d{3})"
| rex field=_raw "(?:^|\s)(?:client_ip|src_ip|ip)=(?<kv_client_ip>(?:\d{1,3}\.){3}\d{1,3})"
| rex field=_raw "(?:^|\s)(?:status|status_code)=(?<kv_status>\d{3})"
| eval client_ip=coalesce(client_ip,kv_client_ip,"unparsed")
| eval http_status=coalesce(http_status,kv_status,"unparsed"), http_method=coalesce(http_method,"unparsed"), url_path=coalesce(url_path,"unparsed")
| table _time host client_ip http_method url_path http_status _raw
| sort 0 -_time
