# Local secrets and raw telemetry
# Splunk Cloud deployment/credential packages can use .spl too.
# Ignore .spl by default; allow only documented plaintext search locations.
*.spl
!detections/linux/*.spl
!investigations/SOC-003/*.spl
*.pem
*.key
*.p12
*.pfx
.env
.env.*
*token*
*secret*
*credential*
*.log
*.pcap
*.pcapng
.DS_Store
__pycache__/
