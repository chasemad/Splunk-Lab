            "type": "block",
            "position": {
              "x": 0,
              "y": 0,
              "w": 1200,
              "h": 130
            }
          },
          {
            "item": "viz_total_events",
            "type": "block",
            "position": {
              "x": 0,
              "y": 130,
              "w": 400,
              "h": 160
            }
          },
          {
            "item": "viz_host_count",
            "type": "block",
            "position": {
              "x": 400,
              "y": 130,
              "w": 400,
              "h": 160
            }
          },
          {
            "item": "viz_last_event",
            "type": "block",
            "position": {
              "x": 800,
              "y": 130,
              "w": 400,
              "h": 160
            }
          },
          {
            "item": "viz_volume_trend",
