{
    "title": "Splunk SOC Lab | Live Security Operations",
    "description": "Controlled Linux SIEM laboratory. Three-tab monitoring and investigation workspace backed by saved Splunk reports. Reviewed evidence is lab-generated, not enterprise incident traffic.",
    "inputs": {
        "input_global_trp": {
            "options": {
                "defaultValue": "-24h@h,now",
                "token": "global_time"
            },
            "title": "Investigation time range",
            "type": "input.timerange"
        },
        "input_investigation_session": {
            "options": {
                "defaultValue": 33,
                "min": 0,
                "step": 1,
                "token": "investigation_session"
            },
            "title": "Audit session (case filter)",
            "type": "input.number"
        }
    },
    "defaults": {
        "dataSources": {
            "ds.search": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            },
            "ds.spl2": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            }
        }
    },
    "visualizations": {
        "viz_changes": {
            "dataSources": {
                "primary": "ds_files"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "File operations · grouped Auditd records",
            "type": "splunk.table"
        },
        "viz_endpoint_intro": {
            "options": {
                "markdown": "## ENDPOINT TELEMETRY\nReview identity and privilege context. Root processes during login initialization do **not** automatically indicate suspicious `sudo` activity."
            },
            "type": "splunk.markdown"
        },
        "viz_file_detail": {
            "dataSources": {
                "primary": "ds_files"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Monitored file-change operations",
            "type": "splunk.table"
        },
        "viz_file_evidence": {
            "dataSources": {
                "primary": "ds_case_files"
            },
            "description": "Only monitored operations matching the chosen audit session (ses).",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "File evidence - selected audit session",
            "type": "splunk.table"
        },
        "viz_host_count": {
            "dataSources": {
                "primary": "ds_kpi_hosts_seen"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Hosts observed in range",
            "type": "splunk.singlevalue"
        },
        "viz_investigation_intro": {
            "options": {
                "markdown": "## INVESTIGATION WORKSPACE · SESSION-FOCUSED REVIEW\nChoose an **Audit session number** below. The correlation table and the two evidence tables use that session; the broad activity timeline below remains **all sessions** for background context. Set the global time range to include the selected session before investigating. Different sessions are not interchangeable, and nearby events are not proof of attribution."
            },
            "type": "splunk.markdown"
        },
        "viz_last_event": {
            "dataSources": {
                "primary": "ds_kpi_minutes_since_last"
            },
            "description": "A freshness indicator, not an uptime or heartbeat guarantee",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Minutes since newest indexed event",
            "type": "splunk.singlevalue"
        },
        "viz_live_timeline": {
            "dataSources": {
                "primary": "ds_timeline"
            },
            "description": "This timeline remains global within the selected time window and is NOT filtered by Audit session; use it only for surrounding context.",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Recent activity timeline - all sessions",
            "type": "splunk.table"
        },
        "viz_overview_intro": {
            "options": {
                "markdown": "## SOC OPERATIONS · LIVE LINUX\nMonitored endpoint: `soc-ubuntu-01` · Index: `soc-live` · Lab traffic only\n\nThe investigation time picker controls inline metrics and all eight saved report sources."
            },
            "type": "splunk.markdown"
        },
        "viz_proc": {
            "dataSources": {
                "primary": "ds_process"
            },
            "description": "Auditd execve records; original login ID and effective user context.",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Selected process executions",
            "type": "splunk.table"
        },
        "viz_process_evidence": {
            "dataSources": {
                "primary": "ds_case_process"
            },
            "description": "Only audited process executions matching the chosen audit session (ses).",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Process evidence - selected audit session",
            "type": "splunk.table"
        },
        "viz_session_correlation": {
            "dataSources": {
                "primary": "ds_case_correlation"
            },
            "description": "Candidate PID and timestamp matching, scoped to selected audit session. Verify raw LOGIN and auth records.",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "SSH to Auditd correlation - selected audit session",
            "type": "splunk.table"
        },
        "viz_ssh": {
            "dataSources": {
                "primary": "ds_ssh"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "SSH authentication sessions",
            "type": "splunk.table"
        },
        "viz_sudo": {
            "dataSources": {
                "primary": "ds_sudo"
            },
            "description": "Shows sudo COMMAND records from auth.log where present.",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Sudo command records",
            "type": "splunk.table"
        },
        "viz_telemetry": {
            "dataSources": {
                "primary": "ds_telemetry"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Telemetry source inventory",
            "type": "splunk.table"
        },
        "viz_total_events": {
            "dataSources": {
                "primary": "ds_kpi_total_events"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Indexed events in range",
            "type": "splunk.singlevalue"
        },
        "viz_volume_trend": {
            "dataSources": {
                "primary": "ds_event_trend"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Event volume by sourcetype · 15 min",
            "type": "splunk.line"
        },
        "viz_web": {
            "dataSources": {
                "primary": "ds_web"
            },
            "description": "Verify URI, method and response-code extraction before treating this as a detection.",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Web request activity",
            "type": "splunk.table"
        }
    },
    "dataSources": {
        "ds_case_correlation": {
            "name": "Case-scoped SSH to Auditd correlation",
            "options": {
                "query": "index=\"soc-live\" host=\"soc-ubuntu-01\" source=\"/var/log/audit/audit.log\"\n(\"type=LOGIN\" OR (\"type=SYSCALL\" (\"soc_lab_exec\" OR \"soc_lab_file_change\")))\n| rex field=_raw \"^type=(?<record_type>[A-Z_]+)\"\n| rex field=_raw \"(?:^|\\s)pid=(?<pid>\\d+)\"\n| rex field=_raw \"(?:^|\\s)ses=(?<audit_session>\\d+)\"\n| rex field=_raw \"(?:^|\\s)comm=\\\"(?<process>[^\\\"]+)\\\"\"\n| eval is_exec=if(record_type=\"SYSCALL\" AND match(_raw,\"key=\\\"soc_lab_exec\\\"\"),1,0)\n| eval is_file=if(record_type=\"SYSCALL\" AND match(_raw,\"key=\\\"soc_lab_file_change\\\"\"),1,0)\n| stats\n    values(eval(if(record_type=\"LOGIN\",pid,null()))) as ssh_pid\n    min(eval(if(record_type=\"LOGIN\",_time,null()))) as audit_login_time\n    sum(is_exec) as audited_execs\n    sum(is_file) as monitored_file_ops\n    values(eval(if(is_exec=1,process,null()))) as executed_processes\n    by host audit_session\n| where isnotnull(ssh_pid)\n| mvexpand ssh_pid\n| join type=inner host ssh_pid [\n    search index=\"soc-live\" host=\"soc-ubuntu-01\" source=\"/var/log/auth.log\" (\"Accepted password\" OR \"Accepted publickey\")\n    | rex field=_raw \"sshd\\[(?<ssh_pid>\\d+)\\]\"\n    | rex field=_raw \"Accepted (?:password|publickey) for (?<account>\\S+) from (?<src_ip>(?:\\d{1,3}\\.){3}\\d{1,3})\"\n    | eval auth_time=_time\n    | table host ssh_pid account src_ip auth_time\n]\n| where abs(audit_login_time-auth_time)<=120\n| where audit_session=\"$investigation_session$\"\n| eval auth_time=strftime(auth_time,\"%Y-%m-%d %H:%M:%S\")\n| table auth_time host account src_ip ssh_pid audit_session audited_execs monitored_file_ops\n| sort 0 -auth_time"
            },
            "type": "ds.search"
        },
        "ds_case_files": {
            "name": "Case-scoped file audit evidence",
            "options": {
                "query": "index=\"soc-live\" host=\"soc-ubuntu-01\" source=\"/var/log/audit/audit.log\"\n(\"soc_lab_file_change\" OR \"/opt/soc-lab-test/\")\n| rex field=_raw \"msg=audit\\((?<audit_id>[^)]+)\\)\"\n| rex field=_raw \"type=(?<record_type>[A-Z_]+)\"\n| rex field=_raw \"name=\\\"(?<file_path>/opt/soc-lab-test/[^\\\"]+)\\\"\"\n| rex field=_raw \"success=(?<operation_success>\\w+)\"\n| rex field=_raw \"comm=\\\"(?<process>[^\\\"]+)\\\"\"\n| rex field=_raw \"\\bauid=(?<audit_user>\\d+)\"\n| rex field=_raw \"\\bses=(?<audit_session>\\d+)\"\n| eval has_file_rule=if(match(_raw,\"key=\\\"soc_lab_file_change\\\"\"),1,0)\n| stats earliest(_time) as first_seen\n        max(has_file_rule) as has_file_rule\n        values(file_path) as files\n        values(operation_success) as outcomes\n        values(process) as processes\n        values(audit_user) as audit_users\n        values(audit_session) as sessions\n        values(record_type) as record_types\n        count as raw_records\n        by host audit_id\n| where has_file_rule=1 AND isnotnull(files) AND mvfind(outcomes,\"^yes$\")>=0\n| mvexpand sessions\n| where sessions=\"$investigation_session$\"\n| eval first_seen=strftime(first_seen,\"%Y-%m-%d %H:%M:%S\")\n| table first_seen host audit_id files processes audit_users sessions outcomes raw_records record_types\n| sort 0 -first_seen"
            },
            "type": "ds.search"
        },
        "ds_case_process": {
            "name": "Case-scoped audited processes",
            "options": {
                "query": "index=\"soc-live\" host=\"soc-ubuntu-01\" source=\"/var/log/audit/audit.log\" \"type=SYSCALL\" \"key=\\\"soc_lab_exec\\\"\"\n| rex field=_raw \"msg=audit\\((?<audit_id>[^)]+)\\)\"\n| rex field=_raw \"(?:^|\\s)comm=\\\"(?<process>[^\\\"]+)\\\"\"\n| rex field=_raw \"(?:^|\\s)auid=(?<audit_user>\\d+)\"\n| rex field=_raw \"(?:^|\\s)euid=(?<effective_uid>\\d+)\"\n| rex field=_raw \"(?:^|\\s)ses=(?<audit_session>\\d+)\"\n| rex field=_raw \"(?:^|\\s)pid=(?<pid>\\d+)\"\n| rex field=_raw \"(?:^|\\s)ppid=(?<parent_pid>\\d+)\"\n| rex field=_raw \"(?:^|\\s)success=(?<success>\\w+)\"\n| where audit_session=\"$investigation_session$\"\n| table _time host audit_id audit_user effective_uid audit_session process pid parent_pid success\n| sort 0 -_time"
            },
            "type": "ds.search"
        },
        "ds_correlation": {
            "name": "SSH Session Correlation",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-COR-001 — Session Correlation",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_event_trend": {
            "name": "Event volume (15 minute bins)",
            "options": {
                "query": "index=\"soc-live\" host=\"soc-ubuntu-01\" | timechart span=15m count by sourcetype limit=6 useother=f"
            },
            "type": "ds.search"
        },
        "ds_files": {
            "name": "Monitored File Changes",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-DET-003 - Monitored File Changes",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_kpi_base": {
            "name": "SOC overview metrics",
            "options": {
                "query": "index=\"soc-live\" host=\"soc-ubuntu-01\" | stats count as total_events dc(host) as hosts_seen latest(_time) as last_event | eval minutes_since_last=if(isnotnull(last_event),round((now()-last_event)/60,1),null())"
            },
            "type": "ds.search"
        },
        "ds_kpi_hosts_seen": {
            "name": "Hosts represented",
            "options": {
                "extend": "ds_kpi_base",
                "query": "| table hosts_seen"
            },
            "type": "ds.chain"
        },
        "ds_kpi_minutes_since_last": {
            "name": "Minutes since last event",
            "options": {
                "extend": "ds_kpi_base",
                "query": "| table minutes_since_last"
            },
            "type": "ds.chain"
        },
        "ds_kpi_total_events": {
            "name": "Total events",
            "options": {
                "extend": "ds_kpi_base",
                "query": "| table total_events"
            },
            "type": "ds.chain"
        },
        "ds_process": {
            "name": "Process Execution",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-DET-004 — Process Execution",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_ssh": {
            "name": "SSH Authentication Sessions",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-DET-001 - SSH Authentication Sessions",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_sudo": {
            "name": "Sudo Activity",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-DET-002 — Sudo Activity",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_telemetry": {
            "name": "Telemetry Health",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-MON-001 — Telemetry Health",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_timeline": {
            "name": "Investigation Timeline",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-INV-001 — Investigation Timeline",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_web": {
            "name": "HTTP Requests",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-DET-005 — HTTP Requests",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        }
    },
