{
    "title": "Splunk SOC Lab | Live Security Operations",
    "description": "Controlled Linux SIEM laboratory. Three-tab monitoring and investigation workspace backed by saved Splunk reports. Reviewed evidence is lab-generated, not enterprise incident traffic.",
    "inputs": {
        "input_global_trp": {
            "options": {
                "defaultValue": "-24h@h,now",
                "token": "global_time"
            },
            "title": "Investigation time range",
            "type": "input.timerange"
        }
    },
    "defaults": {
        "dataSources": {
            "ds.search": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            },
            "ds.spl2": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            }
        }
    },
    "visualizations": {
        "viz_changes": {
            "dataSources": {
                "primary": "ds_files"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "File operations · grouped Auditd records",
            "type": "splunk.table"
        },
        "viz_endpoint_intro": {
            "options": {
                "markdown": "## ENDPOINT TELEMETRY\nReview identity and privilege context. Root processes during login initialization do **not** automatically indicate suspicious `sudo` activity."
            },
            "type": "splunk.markdown"
        },
        "viz_file_detail": {
            "dataSources": {
                "primary": "ds_files"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Monitored file-change operations",
            "type": "splunk.table"
        },
        "viz_file_evidence": {
            "dataSources": {
                "primary": "ds_files"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Auditd file evidence",
            "type": "splunk.table"
        },
        "viz_host_count": {
            "dataSources": {
                "primary": "ds_kpi_hosts_seen"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Hosts observed in range",
            "type": "splunk.singlevalue"
        },
        "viz_investigation_intro": {
            "options": {
                "markdown": "## INVESTIGATION WORKSPACE  ·  SOC-003\nCorrelate SSH authentication to Auditd LOGIN by PID **and** time, then review the resulting audit session.\nOnly an analyst review determines whether observed events were authorized."
            },
            "type": "splunk.markdown"
        },
        "viz_last_event": {
            "dataSources": {
                "primary": "ds_kpi_minutes_since_last"
            },
            "description": "A freshness indicator, not an uptime or heartbeat guarantee",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Minutes since newest indexed event",
            "type": "splunk.singlevalue"
        },
        "viz_live_timeline": {
            "dataSources": {
                "primary": "ds_timeline"
            },
            "description": "A chronological view is not proof that nearby events share the same initiating connection.",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Cross-source activity timeline",
            "type": "splunk.table"
        },
        "viz_overview_intro": {
            "options": {
                "markdown": "## SOC OPERATIONS  ·  LIVE LINUX\nMonitored endpoint: `soc-ubuntu-01`  ·  Index: `soc-live`  ·  Lab traffic only\n\nUse the time picker for inline KPIs/trends; saved report time selection should be checked in Studio."
            },
            "type": "splunk.markdown"
        },
        "viz_proc": {
            "dataSources": {
                "primary": "ds_process"
            },
            "description": "Auditd execve records; original login ID and effective user context.",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Selected process executions",
            "type": "splunk.table"
        },
        "viz_process_evidence": {
            "dataSources": {
                "primary": "ds_process"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Process and session evidence",
            "type": "splunk.table"
        },
        "viz_session_correlation": {
            "dataSources": {
                "primary": "ds_correlation"
            },
            "description": "Review joins and time bounds before relying on this panel.",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "SSH ↔ Auditd session correlation (candidate)",
            "type": "splunk.table"
        },
        "viz_ssh": {
            "dataSources": {
                "primary": "ds_ssh"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "SSH authentication sessions",
            "type": "splunk.table"
        },
        "viz_sudo": {
            "dataSources": {
                "primary": "ds_sudo"
            },
            "description": "Shows sudo COMMAND records from auth.log where present.",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Sudo command records",
            "type": "splunk.table"
        },
        "viz_telemetry": {
            "dataSources": {
                "primary": "ds_telemetry"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Telemetry source inventory",
            "type": "splunk.table"
        },
        "viz_total_events": {
            "dataSources": {
                "primary": "ds_kpi_total_events"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Indexed events in range",
            "type": "splunk.singlevalue"
        },
        "viz_volume_trend": {
            "dataSources": {
                "primary": "ds_event_trend"
            },
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Event volume by sourcetype · 15 min",
            "type": "splunk.line"
        },
        "viz_web": {
            "dataSources": {
                "primary": "ds_web"
            },
            "description": "Verify URI, method and response-code extraction before treating this as a detection.",
            "options": {
                "backgroundColor": "transparent"
            },
            "title": "Web request activity",
            "type": "splunk.table"
        }
    },
    "dataSources": {
        "ds_correlation": {
            "name": "SSH Session Correlation",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-COR-001 — Session Correlation",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_event_trend": {
            "name": "Event volume (15 minute bins)",
            "options": {
                "query": "index=\"soc-live\" host=\"soc-ubuntu-01\" | timechart span=15m count by sourcetype limit=6 useother=f"
            },
            "type": "ds.search"
        },
        "ds_files": {
            "name": "Monitored File Changes",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-DET-003 - Monitored File Changes",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_kpi_base": {
            "name": "SOC overview metrics",
            "options": {
                "query": "index=\"soc-live\" host=\"soc-ubuntu-01\" | stats count as total_events dc(host) as hosts_seen latest(_time) as last_event | eval minutes_since_last=if(isnotnull(last_event),round((now()-last_event)/60,1),null())"
            },
            "type": "ds.search"
        },
        "ds_kpi_hosts_seen": {
            "name": "Hosts represented",
            "options": {
                "extend": "ds_kpi_base",
                "query": "| table hosts_seen"
            },
            "type": "ds.chain"
        },
        "ds_kpi_minutes_since_last": {
            "name": "Minutes since last event",
            "options": {
                "extend": "ds_kpi_base",
                "query": "| table minutes_since_last"
            },
            "type": "ds.chain"
        },
        "ds_kpi_total_events": {
            "name": "Total events",
            "options": {
                "extend": "ds_kpi_base",
                "query": "| table total_events"
            },
            "type": "ds.chain"
        },
        "ds_process": {
            "name": "Process Execution",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-DET-004 — Process Execution",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_ssh": {
            "name": "SSH Authentication Sessions",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-DET-001 - SSH Authentication Sessions",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_sudo": {
            "name": "Sudo Activity",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-DET-002 — Sudo Activity",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_telemetry": {
            "name": "Telemetry Health",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-MON-001 — Telemetry Health",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_timeline": {
            "name": "Investigation Timeline",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-INV-001 — Investigation Timeline",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        },
        "ds_web": {
            "name": "HTTP Requests",
            "options": {
                "app": "search",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                },
                "ref": "LINUX-DET-005 — HTTP Requests",
                "useSavedTimeRange": false
            },
            "type": "ds.savedSearch"
        }
    },
